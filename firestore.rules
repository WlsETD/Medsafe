rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MedSafe：前端改用 Firebase Authentication 登入（帳號 -> username@medsafe.local 的合成 email）。
    // user_roles/{uid} 是唯一可信的身分索引，由 request.auth.uid 直接查詢，
    // 其餘所有集合的存取權限都以此為準，而非單純檢查「有沒有登入」。
    //
    // 部署順序注意：第一次啟用本檔案前，必須先透過 seed.html（在舊的開放規則下）
    // 建立好 Firebase Auth 帳號與對應的 user_roles 文件，否則會沒有任何人符合 isAdmin()，
    // 造成無法再建立新帳號的雞生蛋問題。

    function isAuthed() {
      return request.auth != null;
    }
    function profile() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data;
    }
    function isActive() {
      return isAuthed() && profile().status == 'active';
    }
    function hasRole(r) {
      return isActive() && profile().role == r;
    }
    function isAdmin() { return hasRole('admin'); }
    function isDoctor() { return hasRole('doctor'); }
    function isInsurance() { return hasRole('insurance'); }
    // 帳號的合成 email 由 Firebase Auth 簽發（username@medsafe.local），前端無法竄改，
    // 因此以 token.email 作為 username 的唯一可信來源。
    // 不可改用「檢查 users/{username} 是否存在」——那是 TOCTOU：攻擊者可先寫 user_roles
    // 佔用某 username 卻不寫 users 文件，日後合法使用者註冊同名時檢查仍會通過，形成雙主。
    function ownsUsername(username) {
      return username is string
        && request.auth.token.email == username.lower() + '@medsafe.local';
    }

    // 除了比對已儲存的 profile().username，另要求 token.email 也對得上，
    // 讓「username ↔ Auth 身分」成為每次存取都驗證的不變式，而非註冊當下的一次性快照。
    // 否則若日後 uid 的 email 被變更，舊的 user_roles 欄位仍會續用於授權。
    function isOwnUsername(username) {
      return isActive() && profile().username == username && ownsUsername(username);
    }

    // 自助註冊限定只能建立「patient」角色、狀態為 active 的自己身分，防止自我提權
    function isSelfRegisteringPatient(uid) {
      return isAuthed() && request.auth.uid == uid
        && request.resource.data.role == 'patient'
        && request.resource.data.status == 'active'
        && ownsUsername(request.resource.data.username);
    }

    // 身分索引：只有本人能讀自己的 profile；新增只能是 admin，或使用者本人自助註冊為 patient；
    // 修改/刪除（例如變更角色、停用帳號）只能由 admin
    match /user_roles/{uid} {
      allow read: if isAuthed() && request.auth.uid == uid;
      allow create: if isAdmin() || isSelfRegisteringPatient(uid);
      allow update, delete: if isAdmin();
    }

    // 後台使用者列表（用 username 當 document id，供 admin.html 顯示/管理）
    // 註：同一個 username 只要文件已存在，重複建立會被視為 update 而非 create，因此不會被自助註冊覆蓋
    // 讀取權原本包含 isDoctor()，但這個集合唯一的讀取路徑是 getAllUsers()，
    // 而它只在 admin.html 被呼叫。醫師拿到的因此不是「查得到需要的人」，
    // 而是「對整個集合的無限制列舉」——一次撈出全系統管理員、醫師、核保員與病患的
    // username、Auth UID、角色與帳號狀態。醫師帳號一旦外洩，等於交出全站使用者名冊，
    // 而 UID 正是後續精準攻擊最有價值的輸入。（對抗性稽核 H-2）
    //
    // 移除後醫師端沒有任何功能受影響：dashboard.html 取得病患是靠
    // patient_data 的 assignedDoctor 查詢，不經過本集合。
    match /users/{username} {
      allow read: if isAdmin() || isOwnUsername(username);
      allow create: if isAdmin()
        || (isAuthed() && request.resource.data.uid == request.auth.uid
            && request.resource.data.role == 'patient'
            && request.resource.data.status == 'active'
            && ownsUsername(username));
      allow update, delete: if isAdmin();
    }

    // 系統設定 / 維護模式：所有已登入且啟用中的角色都要能讀（用來判斷是否鎖站），只有 admin 能改
    match /admin_data/{doc} {
      allow read: if isActive();
      allow write: if isAdmin();
    }

    match /doctor_data/{doc} {
      allow read, write: if isAdmin() || isDoctor();
    }

    // 病患本人只能改屬於自己的生活性欄位，不得自行編輯臨床內容。
    // 這在 currentMeds 改讀真實 medications 之後尤其重要：屆時病患自寫 medications
    // 不只是污染核保判斷，而是直接污染交互作用檢測的輸入，屬於臨床安全問題。
    // ddiAlerts 與 stats 同理——那是系統評估的結果，不是使用者可宣告的事實。
    // adherenceLog 是病患對自己服藥情形的逐日回報，性質上就是自述資料，
    // 由病患本人寫入是正確的。醫師端必須據此標示為自述，
    // 不可呈現為系統觀測到的事實（處理方式與 patient_summaries 的 attestedBy 相同）。
    function patientWritableFields() {
      return ['reminders', 'profile', 'fhirPseudonym', 'adherenceLog'];
    }
    function patientOnlyTouchesOwnFields() {
      return request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(patientWritableFields());
    }

    // 只限制 update 是不夠的：Firestore 依「文件是否已存在」區分 create/update，
    // 而攻擊者完全掌控自己的註冊流程——他可以跳過前端的 registerPatient()，
    // 直接 create 一份自帶任意 medications / ddiAlerts / assignedDoctor 的文件，
    // 那樣 update 的欄位限制永遠不會被求值，形同虛設。
    //
    // 注意 size() 對不存在的欄位求值會使整條規則出錯而拒絕，
    // 因此每個欄位都必須先用 in 檢查存在性，否則只寫 fhirPseudonym 的合法建檔會被誤擋。
    function emptyOrAbsent(field) {
      return !(field in request.resource.data) || request.resource.data[field].size() == 0;
    }
    // 白名單只管「哪些欄位可以出現」，不管「裡面裝什麼」。
    // 原本 stats 與 aiInsights 都在白名單內卻沒有任何內容檢查，
    // 於是自助註冊者可以在建檔當下就寫入 stats.safetyScore = 100
    // 與一則自製的「此病患零風險」AI 洞察。（對抗性稽核 S-2）
    //
    // 這兩者與 medications／ddiAlerts 是同一種東西：系統評估的結果，
    // 不是使用者可以宣告的事實。既然後者在 update 時已被擋下，
    // create 時就不該留一個把它們一次寫進去的入口。
    // safetyScore 的乾淨初始值就是 null（「尚未評估」），因此不能寫成
    // get('safetyScore', null)——把 null 當成 get() 的預設值會觸發 Null value error，
    // 整條規則求值失敗而拒絕，連合法的 registerPatient 都會被擋在門外。
    // 存在性用 in 檢查，值再單獨比對。
    function statsInitialIsClean() {
      return !('stats' in request.resource.data)
        || ((!('safetyScore' in request.resource.data.stats)
             || request.resource.data.stats.safetyScore == null)
            && request.resource.data.stats.get('activeMeds', 0) == 0
            && request.resource.data.stats.get('aiChecksToday', 0) == 0);
    }
    // profile.id 是聊天室的路由鍵（chatStore.getMessages(profile.id)）。
    // 建檔時若能填成別人的 username，就能讓自己的介面指向他人的對話串。
    function profileIdMatchesOwner(username) {
      return !('profile' in request.resource.data)
        || request.resource.data.profile.get('id', username) == username;
    }
    function patientInitialDocIsClean(username) {
      return emptyOrAbsent('medications')
        && emptyOrAbsent('ddiAlerts')
        && emptyOrAbsent('aiInsights')
        && statsInitialIsClean()
        && profileIdMatchesOwner(username)
        // assignedDoctor 決定這份病歷會出現在哪位醫師的清單裡（getPatientsByDoctor 照此查詢），
        // 因此不可由自助註冊者自行指定，只能是系統預設值。
        && (!('assignedDoctor' in request.resource.data)
            || request.resource.data.assignedDoctor == 'doctor')
        && request.resource.data.keys().hasOnly(
             ['profile', 'stats', 'medications', 'ddiAlerts', 'aiInsights', 'reminders',
              'assignedDoctor', 'assignedDoctorName', 'fhirPseudonym', 'adherenceLog']);
    }

    // 化名只能從無到有寫入一次。允許反覆更改會讓公開 FHIR 伺服器上
    // 累積無主的孤兒資源，而那些資源無法回收。
    function pseudonymNotOverwritten() {
      return !('fhirPseudonym' in resource.data)
        || request.resource.data.fhirPseudonym == resource.data.fhirPseudonym;
    }

    // ── 化名格式（對抗性稽核 H-5）───────────────────────────────────────
    //
    // pseudonymNotOverwritten() 只保證「已存在的化名不會被改掉」，
    // 對「第一次寫進去的是什麼」完全沒有意見。因此註冊者可以在初始文件裡
    // 把 fhirPseudonym 直接填成另一位病患的化名值——之後雙方同步到 FHIR 伺服器的
    // 資源會共用同一個 identifier，兩人的用藥資料在該伺服器上合併成一份。
    // 這是臨床資料交叉污染，不只是識別碼衝突。
    //
    // 格式檢查擋掉了隨手亂填，也讓「化名必須由 _randomId() 產生」成為資料層的不變式。
    //
    // 【誠實的限制】格式管得住，全域唯一性管不住。Firestore 規則無法查詢
    // 「其他文件是否已使用同一個值」——那需要另立一份以化名為文件 ID 的集合，
    // 由建立該文件的成敗來保證唯一（規則可驗證 create 必須同時成立）。
    // 在目前的資料模型下未實作，因此蓄意複製他人化名仍有可能，只是必須先取得
    // 對方的化名值（該值受 patient_data 的讀取規則保護）。此項列於 Phase 6。
    function pseudonymFormatOk() {
      return request.resource.data.fhirPseudonym is string
        && request.resource.data.fhirPseudonym.matches('DEMO-[0-9A-F]{12}');
    }
    // 只在化名這次「被寫入新值」時檢查格式，不對既有資料回溯施加限制——
    // 否則醫師更新一份早年建立的病歷時，會因為那份文件裡的舊化名格式不符而被擋下。
    function pseudonymWellFormedIfNew() {
      return !('fhirPseudonym' in request.resource.data)
        || (resource != null && ('fhirPseudonym' in resource.data)
            && request.resource.data.fhirPseudonym == resource.data.fhirPseudonym)
        || pseudonymFormatOk();
    }

    // 病患資料：admin/doctor 可讀寫；保險核保員只能讀（核保用途，不得修改病歷）；
    // 病患本人可讀，但寫入僅限上列欄位
    // ── 醫病對話（稽核報告 P1-4）─────────────────────────────────────────
    //
    // 修復前：全部對話存在 localStorage['medsafe_chat_*']，明文、無加密、永不過期，
    // 且醫師端會掃描整個 localStorage 而累積這台電腦上所有病患的對話。
    // 醫病溝通紀錄在法律上屬於病歷的一部分，存在瀏覽器裡既不符合
    // 《醫療機構電子病歷製作及管理辦法》的保存要求，也會隨清除快取而永久遺失。
    //
    // participants 是這串對話的存取控制清單，在建立當下就必須寫對——
    // 事後補寫等於讓對話有一段時間無人可讀或人人可讀。且建立後不可變更，
    // 否則任何參與者都能把自己以外的人加進來，形同單方面轉發整串病歷對話。
    match /conversations/{pid} {
      function convData() {
        return get(/databases/$(database)/documents/conversations/$(pid)).data;
      }
      function inConversation() {
        return isActive()
          && exists(/databases/$(database)/documents/conversations/$(pid))
          && profile().username in convData().participants;
      }

      allow read: if isAdmin()
        || (isActive() && resource != null && profile().username in resource.data.participants);
      // 建立者必須是參與者之一，且病患本人必須在名單內——
      // 一串「病患不在參與者中」的病患對話，等於在病患不知情下建立的病歷。
      allow create: if isActive()
        && request.resource.data.patient == pid
        && pid in request.resource.data.participants
        && profile().username in request.resource.data.participants;
      allow update: if isActive() && resource != null
        && profile().username in resource.data.participants
        && request.resource.data.participants == resource.data.participants;
      // 病歷不可刪除
      allow delete: if false;

      match /messages/{mid} {
        allow read: if isAdmin() || inConversation();
        // from 必須等於發言者自己的角色：少了這一條，病患可以貼出一則
        //「醫師說可以加倍劑量」的訊息，或醫師端看到偽造的病患陳述。
        // 對話中沒有第三種身分——介面上的問候語屬於畫面元素，不應寫進病歷。
        allow create: if inConversation()
          && request.resource.data.from == profile().role
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.at == request.time;
        // 已送出的訊息不可修改或刪除。對話紀錄屬病歷一部分，
        // 事後改寫自己說過的話會讓整串紀錄失去證據價值。
        allow update, delete: if false;
      }
    }

    // ── 病患同意機制（稽核報告 P1-6）─────────────────────────────────────
    //
    // 修復前：`allow read: if ... || isInsurance()` —— 核保員讀得到每一位病患的
    // 完整用藥史與交互作用警示。沒有保戶關聯檢查、沒有病患同意、沒有目的限制、
    // 沒有欄位遮罩、沒有時效。違反個資法第 5 條比例原則與第 16 條目的外利用限制。
    //
    // 修復採兩層：
    //   一、保險端完全失去 patient_data 的讀取權（下方已移除 isInsurance()）
    //   二、改讀 patient_summaries —— 一份只含核保所需最小欄位的摘要，
    //       且必須有未過期、未撤回的 consents 文件才讀得到
    //
    // 為何不是「同意後才讀 patient_data」：Firestore 的讀取是整份文件，
    // 規則無法遮罩欄位。要做到最小化就必須另立一份只含必要欄位的文件，
    // 這是由資料結構保證，而非由規則保證。

    // 同意書的文件 ID 固定為 {病患username}__{保險端username}，
    // 讓規則能以 O(1) 直接定位，不必掃描集合。
    function consentId(patientUsername) {
      return patientUsername + '__' + profile().username;
    }
    function consentPath(patientUsername) {
      return /databases/$(database)/documents/consents/$(consentId(patientUsername));
    }
    // 有效的同意需同時滿足：文件存在、未撤回、未過期、用途相符。
    // 四者缺一不可——一份「永久有效、用途不限」的同意書在個資法下形同未取得同意。
    function hasValidConsent(patientUsername) {
      return isInsurance()
        && exists(consentPath(patientUsername))
        && get(consentPath(patientUsername)).data.revokedAt == null
        && get(consentPath(patientUsername)).data.expiresAt > request.time
        && get(consentPath(patientUsername)).data.scope == 'underwriting-summary';
    }

    // 同意書本身。只有病患能授予與撤回——這是同意之所以是同意的前提。
    match /consents/{cid} {
      // 病患讀自己給出的所有同意；保險端只讀得到「授權對象是自己」的那些。
      // 後者的 list 查詢必須自帶 where(insurer == 自己) 才會通過。
      allow read: if isActive() && (
        isAdmin()
        || (resource != null && isOwnUsername(resource.data.patient))
        || (resource != null && isInsurance() && resource.data.insurer == profile().username)
      );
      // 授予同意：只能由病患本人，且文件 ID 必須與內容一致，
      // 否則可用「內容寫 A、ID 寫 B」的方式讓規則的 O(1) 查找指向錯誤的授權。
      allow create: if isActive()
        && isOwnUsername(request.resource.data.patient)
        && cid == request.resource.data.patient + '__' + request.resource.data.insurer
        && request.resource.data.scope == 'underwriting-summary'
        && request.resource.data.grantedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.revokedAt == null;
      // 撤回：只能由病患本人，且只能改 revokedAt。
      // 不允許刪除——同意與撤回的歷程本身就是需要保存的證據。
      allow update: if isActive()
        && resource != null
        && isOwnUsername(resource.data.patient)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revokedAt'])
        && request.resource.data.revokedAt == request.time;
      allow delete: if false;
    }

    // 核保摘要：只含核保所需的最小欄位，不含藥名、劑量、開立醫院等內容。
    //
    // 【誠實的限制】此摘要由病患端自行產生並寫入，系統無法驗證其真實性。
    // 要做到「摘要必然忠實反映病歷」，需由後端 trigger 在病歷變更時自動重算（Phase 6）。
    // 因此摘要帶有 attestedBy/attestedAt 欄位，核保端看得出這是自述資料，
    // 應依保險實務另行查證，不可當作已驗證的事實。
    // 即便如此，這仍優於原本的做法：原本核保端拿到的是完整病歷，
    // 現在拿到的是最小必要欄位，且必須經病患同意。
    match /patient_summaries/{username} {
      allow read: if isActive() && (
        isAdmin() || isOwnUsername(username) || hasValidConsent(username)
      );
      // 只有病患本人能產生自己的摘要，且欄位白名單固定——
      // 若允許任意欄位，摘要就會逐漸長回一份完整病歷，最小化形同虛設。
      allow create, update: if isActive()
        && isOwnUsername(username)
        && request.resource.data.keys().hasOnly([
             'username', 'displayName', 'ageBand', 'medicationCount',
             'alertCount', 'safetyScore', 'scoreStatus', 'attestedBy', 'attestedAt'
           ])
        && request.resource.data.attestedBy == profile().username
        && request.resource.data.attestedAt == request.time;
      allow delete: if isOwnUsername(username) || isAdmin();
    }

    // ── 處方安全閘門（Phase 4 / 稽核報告 P1-1、P0-4）──────────────────────
    //
    // 前端的「必須先檢測才能開立」是流程控制，不是安全控制——會寫 patient_data 的人
    // 大可繞過畫面直接呼叫 SDK。因此把「可以被規則驗證的部分」下沉到這裡強制執行。
    //
    // 規則能驗證的：每一筆新增的用藥都必須攜帶安全檢查紀錄；若該紀錄的結論是 risk，
    // 就必須同時帶有具名的覆蓋理由。規則無法驗證的：那份檢查結果是否真實、是否對應
    // 這次的用藥組合——那需要後端重算（Cloud Functions），已列於 Phase 6。
    // 但即使只有這一層，「無聲地開立一筆高風險處方」在資料層已不再可能。

    function newMedications() {
      return request.resource.data.medications;
    }
    // 只在用藥清單「變長」時要求安全檢查紀錄。修改其他欄位、移除用藥、
    // 或清單長度不變的整理動作都不受影響，避免規則擋住無關的正常操作。
    function medicationsGrew() {
      return newMedications() is list
        && (resource.data.medications == null
            || newMedications().size() > resource.data.medications.size());
    }
    function addedMed() {
      return newMedications()[newMedications().size() - 1];
    }
    // 新增的用藥必須帶安全檢查紀錄。結論為 risk 時，覆蓋理由為必填——
    // 這正是 CPOE 規範要求「重大警示的覆蓋必須留下具名理由」的資料層落實。
    function addedMedIsAccountable() {
      return addedMed().safetyCheck is map
        && addedMed().safetyCheck.verdict in ['risk', 'unevaluable', 'no-known-interaction']
        && addedMed().safetyCheck.checkedAt is string
        && addedMed().safetyCheck.by is string
        && (addedMed().safetyCheck.verdict != 'risk'
            || (addedMed().safetyCheck.overrideReason is string
                && addedMed().safetyCheck.overrideReason.size() >= 4));
    }
    // 用藥清單沒有變長時不設限；變長時每一筆新增都必須可歸責。
    function prescriptionIsAccountable() {
      return !medicationsGrew() || addedMedIsAccountable();
    }

    match /patient_data/{username} {
      // isInsurance() 已移除（P1-6）：核保端不再讀得到任何病歷，
      // 改為經病患同意後讀取 patient_summaries 中的最小必要欄位。
      //
      // isDoctor() 暫時保留，但這是一個已知的缺口：任何醫師可讀任何病歷，
      // 沒有醫病關係（care relationship）驗證。修復需要轉診與代班的授權模型，
      // 若只用 assignedDoctor 做等值比對，代班醫師與會診醫師會被鎖在門外——
      // 那在急診情境下會直接致命。此項列於 Phase 6，不在本次修復範圍。
      allow read: if isAdmin() || isDoctor() || isOwnUsername(username);
      allow create: if pseudonymWellFormedIfNew() && (isAdmin() || isDoctor()
        || (isOwnUsername(username) && patientInitialDocIsClean(username)));
      // resource != null 守衛：Security Rules 的布林運算子是容錯的（error || true 會得到 true），
      // 因此「求值錯誤必然拒絕」並不是保證，只是目前這條 OR 鏈剛好沒有為真的分支。
      // 少了守衛，日後任何人在此鏈加上一個新條件，都可能讓 resource 為 null 時的求值錯誤
      // 被 || 吸收而靜默放行，且斷言 allow/deny 的測試抓不到這種變化。
      // 新增用藥必須攜帶安全檢查紀錄（見上方 prescriptionIsAccountable）。
      // 此條對 admin 同樣適用——「管理員繞過安全檢查開藥」不該是被允許的路徑。
      // profileIdMatchesOwner：patientOnlyTouchesOwnFields() 用的 affectedKeys() 只看頂層鍵，
      // 而 profile 是 map——病患改動 profile 底下的任何子欄位，頂層都只呈現為「profile 有變」。
      // 因此 profile.id 可被改寫成他人的 username，使聊天室路由指向別人的對話串。
      //（對抗性稽核 H-6）此處只釘住 id；healthSummary 等自述欄位本就該由病患自行維護，
      // 核保端也已看不到它（改讀 patient_summaries 的固定白名單）。
      allow update: if resource != null && prescriptionIsAccountable() && pseudonymWellFormedIfNew()
        && (isAdmin() || isDoctor()
        || (isOwnUsername(username) && patientOnlyTouchesOwnFields()
            && pseudonymNotOverwritten() && profileIdMatchesOwner(username)));
      allow delete: if isAdmin();
    }

    // ── 稽核軌跡（Phase 4 / 稽核報告 P1-5）─────────────────────────────────
    //
    // 《個人資料保護法施行細則》第 12 條第 2 項第 4 款要求建立稽核機制，
    // 《醫療機構電子病歷製作及管理辦法》要求記錄存取軌跡——這是法定必要條件。
    //
    // 本規則能保證的三件事：
    //   一、不可竄改：update 與 delete 一律拒絕，寫下去就改不掉、刪不了。
    //   二、不可冒名：actor 必須等於呼叫者自己的 username，且該 username 必須
    //       與 Auth 簽發的 token.email 相符（ownsUsername），無法把行為記到別人頭上。
    //   三、不可竄改時間：at 必須等於伺服器收到請求的時間，無法回填或造假時序。
    //
    // 本規則「不能」保證的一件事，必須誠實說明：無法保證每個動作都被記錄。
    // 稽核記錄由前端主動寫入，惡意的呼叫端只要不寫就沒有記錄。
    // 要達成「動作必然留痕」，必須由後端 trigger 在資料變更時自動寫入（Phase 6）。
    // 因此目前的稽核軌跡足以支撐臨床可追溯性與事後調查，但不足以對抗蓄意的隱匿。
    match /audit_logs/{doc} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actor == profile().username
        && ownsUsername(request.resource.data.actor)
        && request.resource.data.actorRole == profile().role
        && request.resource.data.at == request.time
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 64;
      allow update, delete: if false;
    }

    // ── 掛號：醫病關係的來源 ────────────────────────────────────────────
    //
    // 【為什麼要有這個集合】
    // 原本病患由 patient_data.assignedDoctor 一個靜態欄位決定歸屬，
    // 而自助註冊者一律預設為展示帳號 doctor。正式環境不可如此。
    //
    // 兩個曾被考慮而否決的替代方案：
    //   一、管理員逐一指派 —— 每筆註冊都要人工介入，不具擴充性。保留為例外後路。
    //   二、醫師搜尋全院病患自行指派 —— 這需要給每位醫師一份可查詢的全院病患索引，
    //       正是「醫護違規查詢名人病歷」的技術前提。該方案不是有 S-1 的風險，
    //       而是把 S-1 制度化成正式功能。
    //
    // 採用的方案是：掛號這個動作本身就是授權事件。權限跟著就診事實走，
    // 而非跟著一個靜態欄位——會診是再建一筆、代班是換 participant、
    // 轉診是建立指向接手醫師的新筆。這正是先前判定
    //「assignedDoctor 等值比對會鎖死代班與會診醫師」的解法。
    //
    // 【誠實的限制】規則無法驗證 doctor 欄位確實是一位醫師。
    // user_roles 以 uid 為鍵，規則無法由 username 反查角色。
    // 病患理論上可掛號給一個不存在的 username——該筆掛號不會出現在任何人的清單中，
    // 屬於無害的髒資料。要真正驗證需另立 username → role 的索引集合。
    match /appointments/{aid} {
      // 病患讀自己的掛號；醫師只讀得到指向自己的那些。
      // 醫師端的 list 查詢必須自帶 where(doctor == 自己) 才會通過。
      allow read: if isActive() && (
        isAdmin()
        || (resource != null && isOwnUsername(resource.data.patient))
        || (resource != null && isDoctor() && resource.data.doctor == profile().username)
      );

      // 掛號：只能替自己掛。status 與 createdAt 不可由呼叫端自訂——
      // 否則病患可直接建立一筆 status 為「已完成」的就診紀錄，
      // 那是在病歷中捏造一次不曾發生的診療。
      allow create: if isActive() && (
        isAdmin()
        || (isOwnUsername(request.resource.data.patient)
            && request.resource.data.doctor is string
            && request.resource.data.doctor.size() > 0
            && request.resource.data.doctor.size() <= 64
            && request.resource.data.status == 'booked'
            && request.resource.data.createdAt == request.time
            && request.resource.data.scheduledAt is timestamp
            && request.resource.data.keys().hasOnly(
                 ['patient', 'patientName', 'doctor', 'doctorName', 'department',
                  'scheduledAt', 'status', 'createdAt', 'note'])
           )
      );

      // 取消或更新狀態：病患本人、該筆的醫師，或 admin。
      // 只能動狀態相關欄位——不可事後改掛給別的醫師，
      // 那等於把一次已發生的就診轉記到他人名下。
      allow update: if isActive() && resource != null
        && (isAdmin()
            || isOwnUsername(resource.data.patient)
            || (isDoctor() && resource.data.doctor == profile().username))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'note']);

      // 就診紀錄不可刪除——與 audit_logs、conversations 同樣的理由：
      // 能被單方面抹除的紀錄，在爭議發生時沒有證據價值。
      allow delete: if false;
    }

    match /insurance_data/{doc} {
      allow read, write: if isAdmin() || isInsurance();
    }

    // graph_data 是交互作用知識圖譜的底層資料，與 ddi_rules 同屬「知識庫」性質，
    // 權限卻不一致：規則庫限定 admin 才能改，圖譜卻開放醫師寫入與刪除。
    // 等於前門上鎖、後門敞開。（對抗性稽核 H-4）
    //
    // 實際上系統只有 dashboard.html 透過 getGraphData() 讀取它，
    // 沒有任何程式路徑會寫入，因此收斂為與 ddi_rules 相同的形狀，功能零影響。
    match /graph_data/{doc} {
      allow read: if isAdmin() || isDoctor();
      allow write: if isAdmin();
    }

    match /ddi_rules/{doc} {
      allow read: if isAdmin() || isDoctor();
      allow write: if isAdmin();
    }

    // ── 保險端集合：撤銷刪除權 ──────────────────────────────────────────
    // （對抗性稽核 H-3）
    //
    // Firestore 的 write 同時涵蓋 create、update 與 delete。原本三個集合都是
    // `allow read, write`，因此任一核保帳號都能一次刪光所有保單、理賠與個案紀錄。
    //
    // 理賠與保單是財務憑證，個案紀錄是照護軌跡——這三者的共同性質是
    // 「事後必須查得到」。能被單一帳號無痕刪除的紀錄，在爭議發生時沒有證據價值，
    // 也讓 H-7（單人核准理賠）從「缺乏覆核」升級為「可核准後銷毀證據」。
    //
    // 因此保留 create 與 update（日常作業需要），撤銷 delete。
    // 誠實的限制：update 仍可改寫內容，規則層無法阻止有寫入權者竄改既有紀錄；
    // 要達成真正的不可竄改，需比照 audit_logs 改為 append-only 並由後端維護狀態機，
    // 那需要理賠流程的完整重新設計，列於 Phase 6。
    match /care_cases/{doc} {
      allow read, create, update: if isAdmin() || isInsurance();
      allow delete: if isAdmin();
    }

    match /insurance_claims/{doc} {
      allow read, create, update: if isAdmin() || isInsurance();
      allow delete: if isAdmin();
    }

    match /insurance_policies/{doc} {
      allow read, create, update: if isAdmin() || isInsurance();
      allow delete: if isAdmin();
    }
  }
}
