{
  "name": "medsafe-security-rules-tests",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MedSafe 的迴歸測試：Firestore 安全規則（唯一真正的存取控制邊界）與藥物身分解析（跨院比對的地基）。兩者改動後務必執行。",
  "scripts": {
    "test": "npm run test:catalog && npm run test:ddi && npm run test:fhir && npm run test:nlu && npm run test:webhook && npm run test:richmenu && npm run test:flextutorial && npm run test:exchange && npm run test:rules && npm run test:deleteuser && npm run test:unbind && npm run test:symptom && npm run test:familyinvite",
    "test:catalog": "node tests/drug-catalog.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project medsafe-rules-test \"node tests/firestore-rules.test.mjs\"",
    "test:ddi": "node tests/ddi-engine.test.mjs",
    "test:fhir": "node tests/fhir-client.test.mjs",
    "test:nlu": "node tests/line-nlu.test.mjs",
    "test:webhook": "node tests/line-webhook.test.mjs",
    "test:richmenu": "node tests/line-richmenu.test.mjs",
    "test:flextutorial": "node tests/line-flex-tutorial.test.mjs",
    "test:exchange": "node tests/line-exchange.test.mjs",
    "test:deleteuser": "firebase emulators:exec --only firestore,auth --project medsafe-rules-test \"node tests/admin-delete-user.test.mjs\"",
    "test:unbind": "firebase emulators:exec --only firestore,auth --project medsafe-rules-test \"node tests/line-unbind.test.mjs\"",
    "test:symptom": "firebase emulators:exec --only firestore --project medsafe-rules-test \"node tests/line-symptom.test.mjs\"",
    "test:familyinvite": "firebase emulators:exec --only firestore,auth --project medsafe-rules-test \"node tests/line-family-invite.test.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^12.0.0"
  }
}
