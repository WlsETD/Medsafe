{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "DESIGN_SYSTEM.md",
      "firestore.rules",
      "firestore.indexes.json",
      "progress-dashboard.html",
      "tests/**",
      "package.json",
      "package-lock.json",
      "DEPLOY_CHECKLIST.md",
      "*.bak",
      "firestore.rules.deployed.bak",
      "*.log",
      "firestore-debug.log",
      "ui-debug.log",
      "node_modules/**",
      "**/.*/**",
      ".git/**",
      ".firebase/**",
      "DDINTER2/**",
      "**/*.csv"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
