{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "README.md",
      "DESIGN_SYSTEM.md",
      "firestore.rules",
      "firestore.indexes.json",
      "progress-dashboard.html",
      "tests/**",
      "package.json",
      "package-lock.json",
      "DEPLOY_CHECKLIST.md",
      "*.bak",
      "firestore.rules.deployed.bak",
      "*.log",
      "firestore-debug.log",
      "ui-debug.log",
      "node_modules/**"
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": false
    }
  }
}
